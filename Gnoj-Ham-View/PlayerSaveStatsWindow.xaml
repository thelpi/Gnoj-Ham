<Window x:Class="Gnoj_Ham_View.PlayerSaveStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gnoj_Ham_View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Background="Gainsboro"
        Title="Statistiques du joueur">
    <Window.Resources>
        <Style x:Key="AltRowBackground" TargetType="Label">
            <Setter Property="Background" Value="LightGray" />
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="75" />
            <ColumnDefinition Width="75" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Première partie" HorizontalContentAlignment="Right" />
        <Label Grid.Row="1" Grid.Column="0" Content="Dernière partie complète" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="2" Grid.Column="0" Content="Nombre de parties" HorizontalContentAlignment="Right" />
        <Label Grid.Row="3" Grid.Column="0" Content="Nombre de manches" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="4" Grid.Column="0" Content="Nombre de Riichi" HorizontalContentAlignment="Right" />
        <Label Grid.Row="5" Grid.Column="0" Content="Nombre de banqueroutes" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="6" Grid.Column="0" Content="Nombre de Tsumo" HorizontalContentAlignment="Right" />
        <Label Grid.Row="7" Grid.Column="0" Content="Nombre de Ron" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="8" Grid.Column="0" Content="Nombre de yakuman" HorizontalContentAlignment="Right" />
        <Label Grid.Row="9" Grid.Column="0" Content="Mains ouvertes" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="0" Grid.Column="1" Content="{Binding FirstGame}" Grid.ColumnSpan="2" />
        <Label Grid.Row="1" Grid.Column="1" Content="{Binding LatestGame}" Grid.ColumnSpan="2" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="2" Grid.Column="1" Content="{Binding GamesCount}" />
        <Label Grid.Row="3" Grid.Column="1" Content="{Binding RoundsCount}" Grid.ColumnSpan="2" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="4" Grid.Column="1" Content="{Binding RiichiCount}" />
        <Label Grid.Row="5" Grid.Column="1" Content="{Binding BankruptCount}" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="6" Grid.Column="1" Content="{Binding TsumoCount}" />
        <Label Grid.Row="7" Grid.Column="1" Content="{Binding RonCount}" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="8" Grid.Column="1" Content="{Binding YakumanCount}" />
        <Label Grid.Row="9" Grid.Column="1" Content="{Binding OpenedHandsCount}" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="2" Grid.Column="2" Content="{Binding GamesPercent}" />
        <Label Grid.Row="4" Grid.Column="2" Content="{Binding RiichiPercent}" />
        <Label Grid.Row="5" Grid.Column="2" Content="{Binding BankruptPercent}" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="6" Grid.Column="2" Content="{Binding TsumoPercent}" />
        <Label Grid.Row="7" Grid.Column="2" Content="{Binding RonPercent}" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="8" Grid.Column="2" Content="{Binding YakumanPercent}" />
        <Label Grid.Row="9" Grid.Column="2" Content="{Binding OpenedHandsPercent}" Style="{StaticResource AltRowBackground}" />
        <TextBlock Margin="0, 5, 0, 0" Grid.Row="10" Grid.ColumnSpan="3" TextWrapping="WrapWithOverflow">Les statistiques sont sauvegardées quand les règles sont celles par défaut.<LineBreak />Les statistiques sont sauvegardées après chaque manche même si la partie est plus tard abandonnée.</TextBlock>
    </Grid>
</Window>
