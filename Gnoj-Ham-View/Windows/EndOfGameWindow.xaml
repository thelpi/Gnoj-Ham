<Window x:Class="Gnoj_Ham_View.EndOfGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gnoj_Ham_View"
        mc:Ignorable="d"
        Title="Fin de partie"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Background="Gainsboro">
    <TabControl Margin="5">
        <TabItem Header="Score">
            <StackPanel>
                <!-- Headers -->
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" VerticalAlignment="Center" Background="LightGray" Content="Rang" />
                    <Label Grid.Column="1" VerticalAlignment="Center" Background="LightGray" Content="Nom" />
                    <Label Grid.Column="2" VerticalAlignment="Center" Background="LightGray" Content="Points" />
                    <Label Grid.Column="3" VerticalAlignment="Center" Background="LightGray" Content="Uma" />
                    <Label Grid.Column="4" VerticalAlignment="Center" Background="LightGray" Content="Score" />
                </Grid>
                <!-- Ranking -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" VerticalAlignment="Center" Content="{Binding Rank}" />
                                <Label Grid.Column="1" VerticalAlignment="Center" Content="{Binding PlayerName}" />
                                <Label Grid.Column="2" VerticalAlignment="Center" Content="{Binding Points}" />
                                <Label Grid.Column="3" VerticalAlignment="Center" DataContext="{Binding Uma}" Style="{StaticResource GainLabelStyle}" />
                                <Label Grid.Column="4" VerticalAlignment="Center" DataContext="{Binding Score}" Style="{StaticResource GainLabelStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
