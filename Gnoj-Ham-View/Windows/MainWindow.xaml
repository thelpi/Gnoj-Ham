<Window x:Class="Gnoj_Ham_View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Gnoj_Ham_View"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="Gainsboro"
        Title="Gnoj-Ham"
        Height="970"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Width"
        Closing="Window_Closing">
    <Window.Resources>
        <Storyboard x:Key="{x:Static loc:MainWindow.OverlayStoryboardResourceName}">
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="grid" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="00:00:00.7500000" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <!-- Any change on the walls dimensions below should impact this value -->
        <sys:Double x:Key="WallTileSizeRate">0.2</sys:Double>
        <!-- Shared by the 8 call-action buttons below, each bound to an ActionButtonViewModel; Margin and
             Foreground are left inline since they differ per button (the riichi button has no left margin;
             three are always red). The others turn magenta when their action is the one advised. -->
        <Style x:Key="{x:Static loc:MainWindow.CallActionButtonStyleResourceName}" TargetType="Button">
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Setter Property="Command" Value="{Binding InvokeCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdvised}" Value="True">
                    <Setter Property="Foreground" Value="DarkMagenta" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tiles: every list of tiles on the table is an ItemsControl laid out horizontally or vertically. -->
        <ItemsPanelTemplate x:Key="HorizontalPanelTemplate">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalPanelTemplate">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="TileTemplate">
            <loc:TileView Tile="{Binding}" IsHighlighted="{Binding IsHighlighted}" />
        </DataTemplate>
        <!-- A tile of the human player's hand: clicking it is handled by the human controls. -->
        <DataTemplate x:Key="HumanTileTemplate">
            <loc:TileView Tile="{Binding}" IsHighlighted="{Binding IsHighlighted}" IsEnabled="{Binding IsEnabled}"
                          Command="{Binding DataContext.Table.Human.SelectTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="DoraTileTemplate">
            <loc:TileView Tile="{Binding}" Rate="0.8" />
        </DataTemplate>
        <DataTemplate x:Key="WallTileTemplate">
            <loc:TileView Tile="{Binding}" Rate="{StaticResource WallTileSizeRate}" />
        </DataTemplate>
        <!-- A declared combination: its tiles run horizontally for the bottom and top seats, vertically for the others. -->
        <DataTemplate x:Key="HorizontalCombinationTemplate">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
        </DataTemplate>
        <DataTemplate x:Key="VerticalCombinationTemplate">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
        </DataTemplate>

        <!-- Player name and wind next to a seat: orange while it is that player's turn. -->
        <Style x:Key="SeatLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="OrangeRed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="5">
        <!-- Configuration expander -->
        <Expander IsExpanded="False" ExpandDirection="Left" DockPanel.Dock="Right">
            <Expander.Header>
                <TextBlock>
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                    Options
                </TextBlock>
            </Expander.Header>
            <StackPanel Orientation="Vertical">
                <StackPanel Margin="0, 5, 0, 5" Orientation="Horizontal">
                    <Label Width="160" />
                    <Button Height="32" Width="32" Command="{Binding NewGameCommand}" ToolTip="Retour à l'accueil / débuter une nouvelle partie.">
                        <Button.Content>
                            <Image Source="../Resources/gohome.png" />
                        </Button.Content>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Width="160" HorizontalContentAlignment="Right" Content="Vitesse des adversaires" />
                    <ComboBox Width="100" VerticalContentAlignment="Center" Height="23" ItemsSource="{Binding Options.CpuSpeedChoices}" SelectedIndex="{Binding Options.CpuSpeedIndex}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Width="160"  HorizontalContentAlignment="Right" Content="Chrono" />
                    <ComboBox Width="100" VerticalContentAlignment="Center" Height="23" ItemsSource="{Binding Options.ChronoSpeedChoices}" SelectedIndex="{Binding Options.ChronoSpeedIndex}" ToolTip="Temps maximal pour prendre une décision." />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Width="160"  HorizontalContentAlignment="Right" Content="Victoire automatique" />
                    <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding Options.AutoCallMahjong}" ToolTip="Les appels 'Ron' et 'Tsumo' sont réalisés automatiquement dés que possible." />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Width="160"  HorizontalContentAlignment="Right" Content="Sons" />
                    <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding Options.PlaySounds}" />
                </StackPanel>
                <Separator Foreground="Black" />
                <TextBlock HorizontalAlignment="Center" Margin="0, 5, 0, 0">
                    <Hyperlink Command="{Binding ShowPlayerStatsCommand}">Statistiques du joueur</Hyperlink>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Margin="0, 10, 0, 0">
                    <Hyperlink Command="{Binding ShowRulesCommand}">Règles et lexique</Hyperlink>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Margin="0, 10, 0, 0">
                    <Hyperlink Command="{Binding ShowAboutCommand}">A propos de Gnoj-Ham</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Expander>
        <!-- The content control allows to use double click -->
        <ContentControl>
            <ContentControl.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SkipCallsCommand}" />
            </ContentControl.InputBindings>
            <!-- The table is a square of 920. Around the centre (240) each side holds two strips, the outer one as
                 wide as a tile is tall plus a margin (60 + 10, twice) and the inner one as wide as three tiles
                 and two margins (200) : 2 * (2 * 70 + 200) + 240 = 920. -->
            <Grid Width="920" Height="920" DataContext="{Binding Table}">
                <Grid.Background>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <StackPanel>
                                <StackPanel.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="LightGreen" Offset="0.10" />
                                        <GradientStop Color="DarkGreen" Offset="1" />
                                    </RadialGradientBrush>
                                </StackPanel.Background>
                                <Image Source="../Resources/dragon_background.png" Opacity="0.1" Stretch="UniformToFill" />
                            </StackPanel>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="200" />
                    <RowDefinition Height="240" />
                    <RowDefinition Height="200" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <!-- Combinations stacks -->
                <!-- P1 (bottom) -->
                <Grid Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="1">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding BottomSeat.Combinations}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource HorizontalCombinationTemplate}" />
                    </DockPanel>
                </Grid>
                <!-- P2 (right) -->
                <ItemsControl Grid.Column="6" Grid.Row="0" Grid.RowSpan="6" ItemsSource="{Binding RightSeat.Combinations}"
                              ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource VerticalCombinationTemplate}" />
                <!-- P3 (top) -->
                <ItemsControl Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="6" ItemsSource="{Binding TopSeat.Combinations}"
                              ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource HorizontalCombinationTemplate}" />
                <!-- P4 (left) -->
                <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LeftSeat.Combinations}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource VerticalCombinationTemplate}" />
                </Grid>

                <!-- Hands stacks -->
                <!-- P1 (bottom): the human player's hand, whose tiles can be clicked -->
                <DockPanel Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="4">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding BottomSeat.HandTiles}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource HumanTileTemplate}" />
                    <!-- Tile just picked (separate view) -->
                    <ItemsControl DockPanel.Dock="Left" Margin="5, 0, 0, 0" ItemsSource="{Binding BottomSeat.PickTiles}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource HumanTileTemplate}" />
                </DockPanel>
                <!-- P2 (right) -->
                <Grid Grid.Column="5" Grid.Row="1" Grid.RowSpan="4" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="1">
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding RightSeat.HandTiles}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                        <!-- Tile just picked (separate view) -->
                        <ItemsControl DockPanel.Dock="Bottom" Margin="0, 0, 0, 5" ItemsSource="{Binding RightSeat.PickTiles}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </DockPanel>
                </Grid>
                <!-- P3 (top) -->
                <Grid Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Row="1">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding TopSeat.HandTiles}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                        <!-- Tile just picked (separate view) -->
                        <ItemsControl DockPanel.Dock="Right" Margin="0, 0, 5, 0" HorizontalAlignment="Right" ItemsSource="{Binding TopSeat.PickTiles}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </DockPanel>
                </Grid>
                <!-- P4 (left) -->
                <DockPanel Grid.Column="1" Grid.Row="2" Grid.RowSpan="4">
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding LeftSeat.HandTiles}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    <!-- Tile just picked (separate view) -->
                    <ItemsControl DockPanel.Dock="Top" Margin="0, 5, 0, 0" ItemsSource="{Binding LeftSeat.PickTiles}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                </DockPanel>

                <!-- Discards: a row is as tall (or, for the seats on the sides, as wide) as a tile (60) -->
                <!-- P1 (bottom) -->
                <StackPanel Orientation="Vertical" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal" Margin="107, 0, 0, 5">
                        <Image HorizontalAlignment="Left" Height="60" Source="../Resources/stick_1000.png"
                               Visibility="{Binding BottomSeat.HasRiichiStick, Converter={StaticResource BooleanToHiddenConverter}}">
                            <Image.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </Image.LayoutTransform>
                        </Image>
                    </StackPanel>
                    <ItemsControl Height="60" ItemsSource="{Binding BottomSeat.DiscardRows[0]}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    <ItemsControl Height="60" ItemsSource="{Binding BottomSeat.DiscardRows[1]}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    <ItemsControl Height="60" ItemsSource="{Binding BottomSeat.DiscardRows[2]}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                </StackPanel>
                <!-- P2 (right) -->
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="4" Grid.RowSpan="2">
                    <StackPanel Orientation="Vertical" Margin="0, 280, 5, 0">
                        <Image HorizontalAlignment="Left" Height="60" Source="../Resources/stick_1000.png"
                               Visibility="{Binding RightSeat.HasRiichiStick, Converter={StaticResource BooleanToHiddenConverter}}" />
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Row="1" Width="60" ItemsSource="{Binding RightSeat.DiscardRows[0]}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Row="1" Width="60" ItemsSource="{Binding RightSeat.DiscardRows[1]}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Row="1" Width="60" ItemsSource="{Binding RightSeat.DiscardRows[2]}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </Grid>
                </StackPanel>
                <!-- P3 (top) -->
                <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" Height="60" ItemsSource="{Binding TopSeat.DiscardRows[2]}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" Height="60" ItemsSource="{Binding TopSeat.DiscardRows[1]}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" Height="60" ItemsSource="{Binding TopSeat.DiscardRows[0]}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    </Grid>
                    <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Margin="0, 5, 107, 0">
                        <Image HorizontalAlignment="Left" Height="60" Source="../Resources/stick_1000.png"
                               Visibility="{Binding TopSeat.HasRiichiStick, Converter={StaticResource BooleanToHiddenConverter}}">
                            <Image.LayoutTransform>
                                <RotateTransform Angle="270" />
                            </Image.LayoutTransform>
                        </Image>
                    </StackPanel>
                </StackPanel>
                <!-- P4 (left) -->
                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="2" Grid.RowSpan="2">
                    <ItemsControl Width="60" ItemsSource="{Binding LeftSeat.DiscardRows[2]}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    <ItemsControl Width="60" ItemsSource="{Binding LeftSeat.DiscardRows[1]}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    <ItemsControl Width="60" ItemsSource="{Binding LeftSeat.DiscardRows[0]}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}" />
                    <StackPanel Orientation="Vertical" Margin="5, 107, 0, 0">
                        <Image HorizontalAlignment="Right" Height="60" Source="../Resources/stick_1000.png"
                               Visibility="{Binding LeftSeat.HasRiichiStick, Converter={StaticResource BooleanToHiddenConverter}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Player infos -->
                <!-- P1 (bottom) -->
                <StackPanel DataContext="{Binding BottomSeat}" ToolTip="{Binding WindToolTip}" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="5" Grid.Column="1">
                    <Label FontSize="16" Content="{Binding WindText}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}" />
                    <Label FontSize="14" Content="{Binding SideName}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}" />
                </StackPanel>
                <!-- P2 (right) -->
                <StackPanel DataContext="{Binding RightSeat}" ToolTip="{Binding WindToolTip}" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="5" Grid.Column="5">
                    <Label FontSize="16" Content="{Binding WindText}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}">
                        <Label.LayoutTransform>
                            <RotateTransform Angle="270" />
                        </Label.LayoutTransform>
                    </Label>
                    <Label FontSize="14" Content="{Binding SideName}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}">
                        <Label.LayoutTransform>
                            <RotateTransform Angle="270" />
                        </Label.LayoutTransform>
                    </Label>
                </StackPanel>
                <!-- P3 (top) -->
                <Grid Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel DataContext="{Binding TopSeat}" ToolTip="{Binding WindToolTip}" Orientation="Vertical" Grid.Column="1">
                        <Label FontSize="14" Content="{Binding SideName}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}">
                            <Label.LayoutTransform>
                                <RotateTransform Angle="180" />
                            </Label.LayoutTransform>
                        </Label>
                        <Label FontSize="16" Content="{Binding WindText}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}">
                            <Label.LayoutTransform>
                                <RotateTransform Angle="180" />
                            </Label.LayoutTransform>
                        </Label>
                    </StackPanel>
                </Grid>
                <!-- P4 (left) -->
                <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel DataContext="{Binding LeftSeat}" ToolTip="{Binding WindToolTip}" Orientation="Horizontal" Grid.Row="1">
                        <Label FontSize="14" Content="{Binding SideName}" VerticalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}">
                            <Label.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </Label.LayoutTransform>
                        </Label>
                        <Label FontSize="16" Content="{Binding WindText}" HorizontalContentAlignment="Center" Style="{StaticResource SeatLabelStyle}">
                            <Label.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </Label.LayoutTransform>
                        </Label>
                    </StackPanel>
                </Grid>

                <!-- General informations -->
                <Grid Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="25" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="60" />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" HorizontalAlignment="Center" ItemsSource="{Binding DoraTiles}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource DoraTileTemplate}" />
                    <Label Grid.Row="2" Grid.Column="1" Content="{Binding BottomSeat.Name}" />
                    <Label Grid.Row="3" Grid.Column="1" Content="{Binding RightSeat.Name}" />
                    <Label Grid.Row="4" Grid.Column="1" Content="{Binding TopSeat.Name}" />
                    <Label Grid.Row="5" Grid.Column="1" Content="{Binding LeftSeat.Name}" />
                    <Label Grid.Row="2" Grid.Column="2" Content="{Binding BottomSeat.Points}" HorizontalAlignment="Right" />
                    <Label Grid.Row="3" Grid.Column="2" Content="{Binding RightSeat.Points}" HorizontalAlignment="Right" />
                    <Label Grid.Row="4" Grid.Column="2" Content="{Binding TopSeat.Points}" HorizontalAlignment="Right" />
                    <Label Grid.Row="5" Grid.Column="2" Content="{Binding LeftSeat.Points}" HorizontalAlignment="Right" />
                    <Label Grid.Row="2" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"
                           Content="{Binding DominantWindText}" ToolTip="{Binding DominantWindToolTip}" />
                    <Label Grid.Row="4" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"
                           Content="{Binding EastTurnCountText}" ToolTip="{Binding EastTurnCountToolTip}" />
                    <StackPanel Grid.Row="2" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Height="30" Stretch="UniformToFill" Source="../Resources/stick_100.png" ToolTip="Honba" />
                        <TextBlock Margin="5, 0, 0, 0" VerticalAlignment="Center" FontSize="16" Text="{Binding HonbaText}" ToolTip="Honba" />
                        <Image Height="30" Margin="5, 0, 0, 0" Stretch="UniformToFill" Source="../Resources/stick_1000.png" ToolTip="Nombre de Riichis en jeu" />
                        <TextBlock Margin="5, 0, 0, 0" VerticalAlignment="Center" FontSize="16" Text="{Binding PendingRiichiText}" ToolTip="Nombre de Riichis en jeu" />
                    </StackPanel>
                    <Label Grid.Row="4" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"
                           Content="{Binding WallTilesLeft}" ToolTip="Tuiles restantes dans le mur.">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWallAlmostEmpty}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                    <!-- Four walls -->
                    <!-- Any change on dimensions here should impact the "WallTileSizeRate" resource value above -->
                    <Border BorderBrush="#d8d6c8" BorderThickness="0.5" Width="154" Height="13" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4">
                        <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding Walls[2]}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource WallTileTemplate}" />
                    </Border>
                    <Border BorderBrush="#d8d6c8" BorderThickness="0.5" Height="154" Width="13" Grid.Row="1" Grid.Column="0" Grid.RowSpan="5">
                        <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding Walls[3]}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource WallTileTemplate}" />
                    </Border>
                    <Border BorderBrush="#d8d6c8" BorderThickness="0.5" Height="154" Width="13" Grid.Row="1" Grid.Column="5" Grid.RowSpan="5">
                        <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding Walls[1]}"
                                      ItemsPanel="{StaticResource VerticalPanelTemplate}" ItemTemplate="{StaticResource WallTileTemplate}" />
                    </Border>
                    <Border BorderBrush="#d8d6c8" BorderThickness="0.5" Width="154" Height="13" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4">
                        <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding Walls[0]}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" ItemTemplate="{StaticResource WallTileTemplate}" />
                    </Border>
                </Grid>

                <!-- Call overlay for opponents -->
                <Grid Name="GrdOverlayCall" Background="Black" Panel.ZIndex="2" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Grid.RowSpan="3" Visibility="Collapsed">
                    <Button Name="BtnOpponentCall" FontWeight="ExtraBold" FontSize="20" Height="36" Width="120" />
                </Grid>

                <!-- Call overlay with actions for player -->
                <Border DataContext="{Binding Human}" Panel.ZIndex="2" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3"
                        Visibility="{Binding IsPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="30, 36, 30, 36">
                    <Border.Background>
                        <SolidColorBrush Color="Black" Opacity="0.3" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Button DataContext="{Binding Riichi}"         Content="RIICHI !"  Style="{StaticResource {x:Static loc:MainWindow.CallActionButtonStyleResourceName}}" Margin="0, 0, 0, 0" />
                        <Button DataContext="{Binding KyuushuKyuuhai}" Content="KYUUSHU !" Style="{StaticResource {x:Static loc:MainWindow.CallActionButtonStyleResourceName}}" Margin="5, 0, 0, 0" Foreground="Red" />
                        <Button DataContext="{Binding Tsumo}"          Content="TSUMO !"   Style="{StaticResource {x:Static loc:MainWindow.CallActionButtonStyleResourceName}}" Margin="5, 0, 0, 0" Foreground="Red" />
