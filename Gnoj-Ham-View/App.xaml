<Application x:Class="Gnoj_Ham_View.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gnoj_Ham_View"
             Startup="Application_Startup">
    <!-- ToolTipService.InitialShowDelay is set globally for every FrameworkElement in App.xaml.cs's
         static constructor, rather than duplicating a Style per control type here. -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- For a Label whose DataContext is a GainViewModel: green for a gain, red for a loss. -->
        <Style x:Key="GainLabelStyle" TargetType="Label">
            <Setter Property="Content" Value="{Binding Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Gain">
                    <Setter Property="Foreground" Value="ForestGreen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Loss">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
