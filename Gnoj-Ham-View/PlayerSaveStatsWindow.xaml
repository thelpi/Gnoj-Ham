<Window x:Class="Gnoj_Ham_View.PlayerSaveStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gnoj_Ham_View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Background="Gainsboro"
        Title="Statistiques du joueur">
    <Window.Resources>
        <Style x:Key="AltRowBackground" TargetType="Label">
            <Setter Property="Background" Value="LightGray" />
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="75" />
            <ColumnDefinition Width="75" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Première partie" HorizontalContentAlignment="Right" />
        <Label Grid.Row="1" Grid.Column="0" Content="Dernière partie complète" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="2" Grid.Column="0" Content="Nombre de parties" HorizontalContentAlignment="Right" />
        <Label Grid.Row="3" Grid.Column="0" Content="Nombre de manches" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="4" Grid.Column="0" Content="Nombre de Riichi" HorizontalContentAlignment="Right" />
        <Label Grid.Row="5" Grid.Column="0" Content="Nombre de banqueroutes" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="6" Grid.Column="0" Content="Nombre de Tsumo" HorizontalContentAlignment="Right" />
        <Label Grid.Row="7" Grid.Column="0" Content="Nombre de Ron" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="8" Grid.Column="0" Content="Nombre de yakuman" HorizontalContentAlignment="Right" />
        <Label Grid.Row="9" Grid.Column="0" Content="Mains ouvertes" HorizontalContentAlignment="Right" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="0" Grid.Column="1" Name="LblFirstGame" Grid.ColumnSpan="2" />
        <Label Grid.Row="1" Grid.Column="1" Name="LblLatestGame" Grid.ColumnSpan="2" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="2" Grid.Column="1" Name="LblGamesCount" />
        <Label Grid.Row="3" Grid.Column="1" Name="LblRoundsCount" Grid.ColumnSpan="2" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="4" Grid.Column="1" Name="LblRiichiCount" />
        <Label Grid.Row="5" Grid.Column="1" Name="LblBankruptCount" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="6" Grid.Column="1" Name="LblTsumoCount" />
        <Label Grid.Row="7" Grid.Column="1" Name="LblRonCount" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="8" Grid.Column="1" Name="LblYakumanCount" />
        <Label Grid.Row="9" Grid.Column="1" Name="LblOpenedHands" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="2" Grid.Column="2" Name="LblGamesPercent" />
        <Label Grid.Row="4" Grid.Column="2" Name="LblRiichiPercent" />
        <Label Grid.Row="5" Grid.Column="2" Name="LblBankruptPercent" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="6" Grid.Column="2" Name="LblTsumoPercent" />
        <Label Grid.Row="7" Grid.Column="2" Name="LblRonPercent" Style="{StaticResource AltRowBackground}" />
        <Label Grid.Row="8" Grid.Column="2" Name="LblYakumanPercent" />
        <Label Grid.Row="9" Grid.Column="2" Name="LblOpenedHandsPercent" Style="{StaticResource AltRowBackground}" />
        <TextBlock Margin="0, 5, 0, 0" Grid.Row="10" Grid.ColumnSpan="3" TextWrapping="WrapWithOverflow">Les statistiques sont sauvegardées quand les règles sont celles par défaut.<LineBreak />Les statistiques sont sauvegardées après chaque manche même si la partie est plus tard abandonnée.</TextBlock>
    </Grid>
</Window>
